# FlightAware API Configuration
# Get your API key from https://flightaware.com/commercial/aeroapi/
FLIGHTAWARE_API_KEY=your_flightaware_api_key_here

# Google Sheets Configuration
# Create a Google Cloud project and enable Sheets API
# Download credentials.json from the Cloud Console
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_FILE=credentials.json

# Default Aircraft Settings
AIRCRAFT_TAIL_NUMBER=N790TB
AIRCRAFT_MAKE=SOCATA
AIRCRAFT_MODEL=TBM 700B

# Pilot Settings
DEFAULT_PILOT_FUNCTION=PIC

# Flask Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
PORT=5051
HOST=0.0.0.0

# Local data storage
DATA_FILE=logbook_data.json
